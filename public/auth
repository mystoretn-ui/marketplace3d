<!doctype html>
<html lang="fr">

<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <title>Bienvenue — Marketplace3D</title>

  <link rel="stylesheet" href="/css/style.css">
</head>

<body class="auth-page">

  <div class="auth-card">

    <!-- Logo -->
    <a class="brand centered" href="/">
      <span class="brand-mark">M3</span>
      <span>Marketplace3D</span>
    </a>

    <!-- Title -->
    <h1>Bienvenue sur Marketplace3D</h1>

    <p>
      Connectez-vous à votre compte ou créez votre portfolio.
    </p>

    <!-- Buttons -->
    <div
      style="
        display:flex;
        flex-direction:column;
        gap:12px;
        margin-top:25px;
      "
    >

      <!-- Login -->
      <a
        href="/login.html"
        class="primary-btn full"
      >
        S'identifier
      </a>

      <!-- Inscription -->
      <a
        href="/register.html"
        class="secondary-btn"
        style="
          display:flex;
          justify-content:center;
          align-items:center;
          min-height:44px;
        "
      >
        Inscription
      </a>

    </div>

    <!-- Information -->
    <div class="demo-box">

      <b>Votre compte Marketplace3D</b>

      <br>

      Connectez-vous si vous avez déjà un compte,
      sinon créez votre compte et votre portfolio.

    </div>

  </div>

</body>

</html>
