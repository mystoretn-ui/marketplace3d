async function api(url, options = {}) {
  const r = await fetch(url, options);
  let d = {};
  try { d = await r.json(); } catch {}
  if (!r.ok) throw new Error(d.error || "Erreur");
  return d;
}

const msg = document.getElementById("formMsg");

const loginForm = document.getElementById("loginForm");
const loginEmail = document.getElementById("email");
const loginPassword = document.getElementById("password");

loginForm?.addEventListener("submit", async (e) => {
  e.preventDefault();
  msg.textContent = "Connexion...";
  try {
    const d = await api("/api/login", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({
        email: loginEmail.value.trim(),
        password: loginPassword.value
      })
    });
    window.location.href = d.redirect || "/";
  } catch (x) {
    msg.textContent = x.message;
  }
});

const registerForm = document.getElementById("registerForm");
const registerUsername = document.getElementById("username");
const registerEmail = document.getElementById("email");
const registerPassword = document.getElementById("password");
const registerConfirm = document.getElementById("confirm");
const registerBio = document.getElementById("bio");

registerForm?.addEventListener("submit", async (e) => {
  e.preventDefault();

  if (registerPassword.value !== registerConfirm.value) {
    msg.textContent = "Les mots de passe ne correspondent pas.";
    return;
  }

  msg.textContent = "Création du compte...";

  try {
    const d = await api("/api/register", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({
        username: registerUsername.value.trim(),
        email: registerEmail.value.trim(),
        password: registerPassword.value,
        bio: registerBio.value.trim()
      })
    });

    window.location.href = d.redirect || "/profile.html";
  } catch (x) {
    msg.textContent = x.message;
  }
});
